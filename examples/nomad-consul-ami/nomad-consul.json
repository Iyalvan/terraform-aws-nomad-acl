{
  "min_packer_version": "0.12.0",
  "variables": {
    "aws_region": "us-east-1",
    "nomad_version": "2.0.4",
    "consul_module_version": "v0.10.1",
    "consul_version": "2.0.2",
    "ami_name_prefix": "nomad-consul"
  },
  "builders": [
    {
      "name": "ubuntu22-ami",
      "ami_name": "{{user `ami_name_prefix`}}-ubuntu22-{{isotime | clean_resource_name}}",
      "ami_description": "An example of how to build an Ubuntu 22.04 AMI that has Nomad and Consul installed",
      "instance_type": "t3.micro",
      "region": "{{user `aws_region`}}",
      "type": "amazon-ebs",
      "source_ami_filter": {
        "filters": {
          "virtualization-type": "hvm",
          "architecture": "x86_64",
          "name": "ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*",
          "root-device-type": "ebs"
        },
        "owners": ["099720109477"],
        "most_recent": true
      },
      "ssh_username": "ubuntu"
    },
    {
      "name": "ubuntu24-ami",
      "ami_name": "{{user `ami_name_prefix`}}-ubuntu24-{{isotime | clean_resource_name}}",
      "ami_description": "An example of how to build an Ubuntu 24.04 AMI that has Nomad and Consul installed",
      "instance_type": "t3.micro",
      "region": "{{user `aws_region`}}",
      "type": "amazon-ebs",
      "source_ami_filter": {
        "filters": {
          "virtualization-type": "hvm",
          "architecture": "x86_64",
          "name": "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*",
          "root-device-type": "ebs"
        },
        "owners": ["099720109477"],
        "most_recent": true
      },
      "ssh_username": "ubuntu"
    },
    {
      "name": "amazon-linux-2023-amd64-ami",
      "ami_name": "{{user `ami_name_prefix`}}-amazon-linux-2023-amd64-{{isotime | clean_resource_name}}",
      "ami_description": "An Amazon Linux 2023 x86_64 AMI that has Nomad and Consul installed.",
      "instance_type": "t3.micro",
      "region": "{{user `aws_region`}}",
      "type": "amazon-ebs",
      "source_ami_filter": {
        "filters": {
          "virtualization-type": "hvm",
          "architecture": "x86_64",
          "name": "al2023-ami-2023.*-x86_64",
          "root-device-type": "ebs"
        },
        "owners": ["amazon"],
        "most_recent": true
      },
      "ssh_username": "ec2-user"
    },
    {
      "name": "amazon-linux-2023-arm64-ami",
      "ami_name": "{{user `ami_name_prefix`}}-amazon-linux-2023-arm64-{{isotime | clean_resource_name}}",
      "ami_description": "An Amazon Linux 2023 ARM64 AMI that has Nomad and Consul installed.",
      "instance_type": "t4g.micro",
      "region": "{{user `aws_region`}}",
      "type": "amazon-ebs",
      "source_ami_filter": {
        "filters": {
          "virtualization-type": "hvm",
          "architecture": "arm64",
          "name": "al2023-ami-2023.*-arm64",
          "root-device-type": "ebs"
        },
        "owners": ["amazon"],
        "most_recent": true
      },
      "ssh_username": "ec2-user"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": ["sudo apt-get update -y", "sudo apt-get install -y git"],
      "only": ["ubuntu22-ami", "ubuntu24-ami"]
    },
    {
      "type": "shell",
      "inline": ["sudo yum install -y git"],
      "only": ["amazon-linux-2023-amd64-ami", "amazon-linux-2023-arm64-ami"]
    },
    {
      "type": "shell",
      "inline": ["mkdir -p /tmp/terraform-aws-nomad"],
      "pause_before": "30s"
    },
    {
      "type": "file",
      "source": "{{template_dir}}/../../",
      "destination": "/tmp/terraform-aws-nomad"
    },
    {
      "type": "shell",
      "environment_vars": [
        "NOMAD_VERSION={{user `nomad_version`}}",
        "CONSUL_VERSION={{user `consul_version`}}",
        "CONSUL_MODULE_VERSION={{user `consul_module_version`}}"
      ],
      "script": "{{template_dir}}/setup_nomad_consul.sh"
    }
  ]
}
